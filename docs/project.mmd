    %% Layer dependency edges (enforced by import-linter; see
    %% docs/architecture/decisions/0001-onion-architecture-with-import-linter.md)
    CLI -->|"calls use cases via"| Bootstrap
    Bootstrap -->|wires adapters into ports| Application
    Bootstrap -->|constructs concrete adapters| Infrastructure
    Application -->|"depends only on"| Domain
    Infrastructure -->|"implements ports over"| Application
    Infrastructure -->|"reads/writes"| Domain
    cli_api -.->|generated from| api_registry
    cli_asyncio -.->|wraps every async command body,\ncalled by| CLI_run
    cli_asyncio -.->|wraps every async command body,\ncalled by| CLI_midrun

    %% ===================================================================
    %% Run-loop state machine (domain/loop.py) — see
    %% docs/architecture/run-loop-state-machine.md
    %% ===================================================================
    subgraph StateMachine["Run-loop state machine (domain/loop.py — pure, no I/O)"]
        direction LR
        S_PREFLIGHT["PREFLIGHT\n(entered once)"]
        S_RUNNING["RUNNING"]
        S_WAITING["WAITING"]
        S_COMPLETE["COMPLETE (terminal)"]
        S_FAILED["FAILED (terminal)"]
        S_WINDDOWN["exit 75\nWound down\n(terminal)"]
        S_STOPPED["exit 130\nSoft-stopped\n(terminal)"]

        S_PREFLIGHT -->|Available| S_RUNNING
        S_PREFLIGHT -->|WindowExhausted / CreditsExhausted| S_WAITING
        S_PREFLIGHT -->|AuthenticationFailed| S_FAILED
        S_RUNNING -->|"capacity rejection\n(always outranks a completion claim)"| S_WAITING
        S_RUNNING -->|Done and Available| S_COMPLETE
        S_RUNNING -->|Blocked, budget exhausted| S_FAILED
        S_WAITING -->|probe: Available| S_RUNNING
        S_WAITING -->|max_wait exceeded| S_FAILED
        S_RUNNING -->|"WindDownCommand, or should_wind_down()\nat a natural break (Continue+Available+not exhausted)"| S_WINDDOWN
        S_WAITING -->|WindDownCommand breaks the wait| S_WINDDOWN
        S_RUNNING -->|StopCommand| S_STOPPED
        S_WAITING -->|StopCommand| S_STOPPED
    end
    app_runner -->|executes Decision: SendTurn/RunProbe/ScheduleProbe/Finish| StateMachine

    %% ===================================================================
    %% Generated REST surface (claudeloop api ...) — see
    %% docs/guides/rest-api-surface.md and ADR 0006
    %% ===================================================================
    subgraph RestSurface["claudeloop api ... — generated 1:1 over the anthropic SDK"]
        direction LR
        RS_typer["Typer sub-app\n(one command per SDK resource method)"]
        RS_anthropic[("anthropic Python SDK\n(real network client)")]
        RS_drift["CI drift gate (ci.yml)\nre-runs introspect+binder,\nfails the build on any gap"]
    end
    api_introspect --> api_binder --> api_registry --> RS_typer
    RS_typer --> api_gateway --> api_providers --> RS_anthropic
    api_registry -.->|diffed against committed tree by| RS_drift

    %% ===================================================================
    %% Control-plane data flow — second terminal ↔ foreground run/resume
    %% ===================================================================
    subgraph ControlPlane[".claudeloop/runs/<run_id>/ — control plane on disk"]
        direction LR
        CP_inbox["inbox/*.cmd.json"]
        CP_events["events.jsonl (redacted, real-time)"]
        CP_audit["audit.jsonl (phase/turn audit trail)"]
        CP_status["status.json (pollable snapshot)"]
        CP_bus["bus.jsonl (append-only state publications)"]
        CP_snapshots["snapshots/ (handoff JSON + optional bundle)"]
        CP_savepoints["savepoints.jsonl (git save-point index)"]
        CP_stopsummary["stop-summary.md"]
        CP_handoff["handoff.json (written on exit 75)"]
    end
    CLI_midrun -->|writes| CP_inbox
    cmd_wind -->|writes WindDownCommand| CP_inbox
    cmd_stop -->|writes StopCommand| CP_inbox
    CP_inbox -->|polled each turn boundary, normalized by| d_control
    app_runner -->|writes| CP_events
    app_runner -->|writes| CP_audit
    app_runner -->|writes| CP_status
    app_runner -->|writes| CP_bus
    app_runner -->|writes on wind-down| CP_handoff
    app_runner -->|writes on soft stop| CP_stopsummary
    infra_git -->|writes| CP_savepoints
    infra_snapshot -->|writes| CP_snapshots
    cmd_logs -->|tails| CP_events
    cmd_status -->|reads| CP_status
    cmd_watch -->|follows| CP_bus
    infra_redact -->|"strips secrets before any line reaches"| CP_events

    %% ===================================================================
    %% Security boundaries (see SECURITY.md and the claudeloop-agent-sdk skill)
    %% ===================================================================
    SEC1["Security boundary:\nonly infrastructure/agent/* may import claude_agent_sdk"]
    SEC2["Security boundary:\nonly infrastructure/api/* drives the real anthropic client"]
    SEC3["Security boundary:\ndomain/ has zero I/O and zero credentials, enforced by import-linter"]
    SEC4["Security boundary:\nSessions always start permission_mode=bypassPermissions;\nManual mode uses control-plane approve/deny with a timeout — never stdin"]
    SEC1 -.-> infra_agent
    SEC2 -.-> infra_api
    SEC3 -.-> Domain
    SEC4 -.-> ag_autonomy
    SEC4 -.-> infra_tool_approval

    %% ===================================================================
    %% CI / release pipeline — see docs/contributing/release-process.md
    %% ===================================================================
    subgraph Pipeline["CI & release pipeline (.github/workflows/)"]
        direction TB
        WF_feature["feature/* branch"]
        WF_ci["ci.yml (CI)\nruff · mypy --strict · pytest\n(100% domain+application coverage) ·\nimport-linter · bandit · pip-audit ·\nREST drift gate"]
        WF_provenance["provenance.yml (Provenance)\nserver-side half of commit provenance\n(pre-push hook is the local half)"]
        WF_prauto["pr-automation.yml (PR automation)\nscans + this exact-head review gate"]
        WF_mergetrain["merge-train.yml (Merge train)\nfills the develop integration branch"]
        WF_promote["promote-to-main.yml (Promote)\nvibey-gh promote: opens/merges a rebase\npromotion PR, develop → main, derives version"]
        WF_release["release.yml (Release)\ndevelop → TestPyPI (vibey-gh dev-stamped build)\nmain → PyPI (version from pyproject.toml,\nOIDC Trusted Publishing; release-please NOT used)"]
        WF_relsurfaces["release-surfaces.yml (Release surfaces)\nbranch ProperDocs + companion surfaces\nafter Release completes"]
        WF_bootstrap["automation-bootstrap.yml (Automation bootstrap)\nadmin workflow_dispatch — loads privileged\nworkflows from the trusted base branch\n(a PR can't prove its own privileged-gate repair)"]

        WF_feature -->|opens PR into develop| WF_ci
        WF_feature --> WF_provenance
        WF_ci --> WF_prauto
        WF_prauto -->|gate passes| WF_mergetrain
        WF_mergetrain -->|develop| WF_promote
        WF_promote -->|main| WF_release
        WF_release --> WF_relsurfaces
        WF_bootstrap -.->|dispatched by an admin to repair| WF_prauto
    end
