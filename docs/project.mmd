        infra_audit["audit.py (audit.jsonl writer)"]
        infra_redact["redact.py (secret redaction before any log line)"]
        infra_state_bus["state_bus.py (bus.jsonl publications)"]
        infra_snapshot["snapshot.py (handoff snapshot + bundle)"]
        infra_git["git_savepoints.py (refs/claudeloop/<run_id>/<n>)"]
