        infra_rundir["rundir.py (.claudeloop/runs/<id>/ layout)"]
        infra_chatmeta["chat_meta.py"]
        infra_chatterlog["chatter_log.py"]
        infra_progress["progress.py"]
        infra_notify["notify.py"]
